# ignore artifacts
dist
node_modules
storybook-static
.next
pnpm-lock.yaml

# Changesets owns everything below: the changelog it generates, and the changeset entries
# themselves, which are transient release metadata consumed and deleted at version time.
# scripts/generate-dependabot-changeset.mjs writes an unaligned markdown table, so without
# this every Dependabot PR fails the format check on a file nobody reads and nothing ships.
CHANGELOG.md
.changeset/*.md
